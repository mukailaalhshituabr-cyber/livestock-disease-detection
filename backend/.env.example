# Get these from Supabase Dashboard -> Project Settings -> API
# (the same public URL + anon key the mobile app uses - no secret needed)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: path to a trained .h5 model file. Leave blank to use mock
# predictions (useful for demoing the app before training finishes).
MODEL_PATH=

API_HOST=0.0.0.0
API_PORT=8000
